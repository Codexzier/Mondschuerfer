# =============================================================================
# .env.example – Vorlage für Zugangsdaten und Einstellungen des Servers
#
# SO BENUTZEN
#   1. Kopieren:   cp .env.example .env        (Windows: copy .env.example .env)
#   2. .env im Texteditor öffnen und mindestens ADMIN_PASSWORD eintragen.
#   3. Starten:    docker compose up -d --build
#   docker compose liest .env automatisch (sie muss neben docker-compose.yml
#   liegen) und setzt die Werte dort für ${NAME} ein. Nach einer Änderung an
#   .env: "docker compose up -d" (erstellt den Container mit den neuen Werten).
#
# WICHTIG
#   - .env enthält dein Admin-Passwort: NIEMALS ins Git einchecken (.env steht
#     in .gitignore) und nicht weitergeben. Unter Linux nur für dich lesbar
#     machen:  chmod 600 .env
#   - Schreibweise: NAME=wert – ohne Leerzeichen um das "=".
#   - Sonderzeichen: Enthält ein Wert $ , " , ' , Leerzeichen oder ein #
#     nach einem Leerzeichen, den Wert in EINFACHE Anführungszeichen setzen:
#         ADMIN_PASSWORD='Mond$tein #42 xyz'
#     Ohne Anführungszeichen würde Compose "$tein" als Variable deuten.
#     Am einfachsten: ein langes Passwort nur aus Buchstaben und Ziffern.
#
# Ausführliche Erklärung aller Einstellungen: server/README.md
# =============================================================================


# -----------------------------------------------------------------------------
# Verwaltungs-Webseite (PFLICHT)
# -----------------------------------------------------------------------------
# Benutzername für die Anmeldung im Browser. Kein Doppelpunkt (:) erlaubt.
# Ein nicht naheliegender Name ("admin", "root") macht Raten zusätzlich schwerer.
ADMIN_USER=mondverwalter

# Passwort für die Webseite. Bleibt es leer, verweigert "docker compose" den
# Start mit einer Fehlermeldung. Der Server verlangt außerdem mindestens 10
# Zeichen und lehnt Standardwörter ab (changeme, passwort, admin, 123456789 ...,
# auch mit angehängten Ziffern, oder Passwort = Benutzername); dann startet nur
# die Webseite nicht, das Spiel schon. Empfehlung: 20 Zeichen oder mehr, zufällig.
# Erzeugen z. B. mit einem Passwortmanager oder unter Linux/macOS mit:
#     openssl rand -base64 30 | tr -d '/+='
ADMIN_PASSWORD=


# -----------------------------------------------------------------------------
# Spielparameter (Startwerte)
#
# Das sind nur STANDARDWERTE. Ändert man die Einstellungen auf der Webseite,
# speichert der Server sie in /data/settings.txt; diese Datei hat danach
# Vorrang, und eine Änderung hier bewirkt nichts mehr – bis man auf der
# Webseite "Zurücksetzen" wählt (löscht settings.txt, dann gelten diese Werte).
# Leer lassen = Standardwert aus docker-compose.yml.
# -----------------------------------------------------------------------------
# Name des Servers in der Lobby des Spiels (höchstens 40 Zeichen)
SERVER_NAME=Mondschürfer-Server

# Schwierigkeitsgrad = Anzahl feindlicher Raumschiffe (Piraten):
#   easy   (leicht)            keine Piraten
#   medium (mittel)            3 Piraten
#   hard   (schwer)            20 Piraten
#   custom (benutzerdefiniert) Anzahl aus ENEMY_SHIPS
DIFFICULTY=medium

# Anzahl Piraten 0–40. Wirkt NUR mit DIFFICULTY=custom (sonst ignoriert).
ENEMY_SHIPS=

# Handelsstationen (verkaufen, reparieren) 1–5 und Werften (aufrüsten) 1–4.
# Eine Änderung baut die Karte neu auf; der Fortschritt der Spieler bleibt.
TRADE_STATIONS=1
SHIPYARDS=1

# Farbe der Mondoberfläche: grey (grau) | orange | blue (blau)
MOON_COLOR=grey

# Höchstens so viele gleichzeitig angemeldete Spieler, 1–64 (Zuschauer kommen
# mit bis zu 16 dazu). Wie viele die eigene Hardware und Internetleitung
# schafft: Tabelle "Hardware-Empfehlung" in server/README.md.
MAX_PLAYERS=16


# -----------------------------------------------------------------------------
# Schutz vor Missbrauch
# -----------------------------------------------------------------------------
# Höchstens so viele gleichzeitige Verbindungen von EINER öffentlichen
# IP-Adresse (0 = unbegrenzt). Spieler aus dem eigenen Heimnetz (192.168.x,
# 10.x, 172.16–31.x) zählen nicht. Bei einer LAN-Party hinter EINEM
# Internetanschluss, die auf einen Server im Internet will, ggf. erhöhen.
MAX_CONNECTIONS_PER_IP=8


# -----------------------------------------------------------------------------
# OPTIONAL: Verwaltungsseite über das Internet (Profil "online", HTTPS mit Caddy)
#
# Nur nötig für:  docker compose --profile online up -d --build
# Domain (oder DynDNS-Name), die auf die öffentliche IP dieses Anschlusses
# zeigt. Router: TCP 80 und 443 an diesen Rechner weiterleiten.
# Beispiel: DOMAIN=mond.example.org
# -----------------------------------------------------------------------------
DOMAIN=
